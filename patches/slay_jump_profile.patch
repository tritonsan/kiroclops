--- a/source/characters/player/player.gd
+++ b/source/characters/player/player.gd
@@ -27,6 +27,16 @@
 var double_jump: bool = true
 
 var state_callback: Callable
+
+
+# KIROCLOPS_PROFILE_BEGIN
+# Values are fitted from video and scaled by observed target body height.
+var motion_profile_family: String = "held_velocity"
+var motion_profile_velocity: float = -298.744020698
+var motion_profile_gravity: float = 2495.45493253
+var motion_profile_hold_ticks: int = 17
+var motion_profile_active: bool = false
+# KIROCLOPS_PROFILE_END
 
 @onready var ray_cast: RayCast2D = $RayCast2D
 
@@ -66,6 +76,10 @@
 
 
 func _physics_process(delta: float) -> void:
+	# A normal jump owns its fitted gravity through the Fall state.
+	# Landing, double-jump, or wall-jump restores original game gravity.
+	if is_on_floor() or (state_callback and state_callback.get_object() not in [states.Jump, states.Fall]):
+		motion_profile_active = false
 	input_direction = _get_input_direction()
 	_set_sprite_direction()
 	
@@ -77,7 +91,10 @@
 
 func apply_gravity(delta: float) -> void:
 	if not is_on_floor():
-		velocity += gravity * delta
+		if motion_profile_active:
+			velocity.y += motion_profile_gravity * delta
+		else:
+			velocity += gravity * delta
 
 
 ## Mainly used by the PlayerState nodes.
