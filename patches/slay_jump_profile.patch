+		return
+	player.motion_profile_active = true
+	profile_held_steps = 1
+	player.velocity.y = player.motion_profile_velocity
+	if player.motion_profile_family == "ballistic":
+		player.velocity.y += player.motion_profile_gravity * player.get_physics_process_delta_time()
 
 
 func state_process(delta: float) -> void:
