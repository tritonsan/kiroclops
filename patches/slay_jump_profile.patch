+var profile_held_steps: int = 0
+
 
 func enter() -> void:
+	# The original WallJump state also enters Jump for its launch. Preserve
+	# that existing launch instead of applying the measured ground-jump rule.
+	var from_wall: bool = player.state_callback and player.state_callback.get_object() == player.states.WallJump
 	super.enter()
