+	if player.motion_profile_active and player.motion_profile_family == "held_velocity" and Input.is_action_pressed("ui_up") and profile_held_steps < player.motion_profile_hold_ticks:
+		player.velocity.y = player.motion_profile_velocity
+	else:
+		player.apply_gravity(delta)
+	profile_held_steps += 1
 	player.move()
