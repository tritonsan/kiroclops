+// Exact closed-form spring state `back` seconds earlier on the same
+// trajectory (same goal). Used to re-anchor a retarget at its input instant.
+export function rewindSpring(position, velocity, goal, back, stiffness, damping) {
+  const x0 = Number.isFinite(position) ? position : goal;
+  const v0 = Number.isFinite(velocity) ? velocity : 0;
+  if (!(back > 0)) return { position: x0, velocity: v0 };
+  const d0 = x0 - goal;
+  const w0 = Math.sqrt(stiffness);
+  const zeta = damping / (2 * w0);
+  const t = -back;
+  let d, v;
+  if (zeta < 1 - 1e-6) {
+    const a = zeta * w0;
+    const wd = w0 * Math.sqrt(1 - zeta * zeta);
+    const e = Math.exp(-a * t), c = Math.cos(wd * t), s = Math.sin(wd * t);
+    d = e * (d0 * c + ((v0 + a * d0) / wd) * s);
+    v = e * (v0 * c - ((a * v0 + w0 * w0 * d0) / wd) * s);
+  } else if (zeta > 1 + 1e-6) {
+    const r = w0 * Math.sqrt(zeta * zeta - 1);
+    const r1 = -zeta * w0 + r, r2 = -zeta * w0 - r;
+    const c1 = (v0 - r2 * d0) / (r1 - r2), c2 = d0 - c1;
+    const e1 = Math.exp(r1 * t), e2 = Math.exp(r2 * t);
+    d = c1 * e1 + c2 * e2;
+    v = c1 * r1 * e1 + c2 * r2 * e2;
+  } else {
+    const e = Math.exp(-w0 * t), b = v0 + w0 * d0;
+    d = e * (d0 + b * t);
+    v = e * (v0 - w0 * b * t);
+  }
+  if (!Number.isFinite(d) || !Number.isFinite(v)) return { position: x0, velocity: v0 };
+  return { position: goal + d, velocity: v };
+}
